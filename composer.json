{
    "name": "pricezaim/sdk",
    "description": "PHP SDK for the pricezaim public API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Pricezaim\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pricezaim\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
