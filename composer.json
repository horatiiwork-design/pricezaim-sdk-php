{
    "name": "pricezaim/sdk",
    "description": "PHP client for the pricezaim public API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pricezaim",
        "api",
        "sdk",
        "auctions",
        "loans"
    ],
    "homepage": "https://github.com/horatiiwork-design/pricezaim-sdk-php",
    "authors": [
        {
            "name": "horatiiwork-design",
            "email": "horatiiwork-design@users.noreply.github.com"
        }
    ],
    "support": {
        "issues": "https://github.com/horatiiwork-design/pricezaim-sdk-php/issues",
        "source": "https://github.com/horatiiwork-design/pricezaim-sdk-php"
    },
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Pricezaim\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pricezaim\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
